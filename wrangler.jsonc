{
	// Cloudflare Workers config. Same pattern as dougrosenbergmusic's
	// site/wrangler.jsonc: a real "main" worker script (src/worker.js) handles
	// POST /api/contact, falling back to the assets binding for everything else.
	//
	// In the Cloudflare dashboard (Workers & Pages -> Create -> connect this GitHub
	// repo, once one exists): root directory "." (this file lives at repo root, unlike
	// the reference project's "site" subfolder - this repo has nothing else in it),
	// build command "npm run build", deploy command "npx wrangler deploy" (default,
	// picks up this file).
	"name": "dougrosenbergdev",
	"main": "./src/worker.js",
	"compatibility_date": "2026-09-08",
	// dougrosenbergdev.com is now a Cloudflare zone (domain cutover completed 2026-09-08 -
	// see PORT_TODO.md) with the conflicting GitHub Pages A-records/CNAME removed, so the
	// custom domain route can attach.
	"routes": [
		{ "pattern": "dougrosenbergdev.com", "custom_domain": true }
	],
	// Lets the Worker send contact-form email via Cloudflare's native Workers
	// send_email binding - no third-party account/API key needed. Requires
	// Email Routing enabled on the dougrosenbergdev.com zone, and
	// destination_address verified as a "Destination Address" in this
	// Cloudflare account's Email Routing settings (one-time email confirmation)
	// before sends will succeed - see src/worker.js.
	"send_email": [
		{
			"name": "CONTACT_EMAIL",
			"destination_address": "doug.rosenberg@gmail.com"
		}
	],
	// Per-IP throttle on POST /api/contact (src/rate-limit.js). Config-only, no
	// dashboard step. namespace_id is an arbitrary account-unique number; period
	// must be 10 or 60 seconds. Counts are per Cloudflare location, so this
	// brakes bursts rather than enforcing an exact quota.
	"ratelimits": [
		{
			"name": "CONTACT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"assets": {
		"directory": "./dist",
		// src/worker.js falls back to env.ASSETS.fetch() for anything the assets
		// layer didn't already serve itself (i.e. every unmatched URL). Without this
		// binding env.ASSETS is undefined, the fallback throws, and unknown paths
		// return Cloudflare error 1101 (HTTP 500) instead of the 404 page.
		"binding": "ASSETS",
		// Without this, unmatched routes get a bare 404 with an empty body instead of
		// the built dist/404.html - Workers static assets defaults to "none", unlike
		// classic Pages which served 404.html automatically.
		// src/pages/404.astro is what this serves.
		"not_found_handling": "404-page"
	}
}
