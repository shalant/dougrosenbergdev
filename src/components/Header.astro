/* ---- below 960px the row collapses into the hamburger sheet ----
   960 matches the hero's own row-to-stacked breakpoint, so the two never disagree (at the old
   820px there was a dead zone where the hero had stacked but the nav still tried to fit its
   full row and clipped the CTA off the edge). */
@media (max-width: 960px) {
  .navbar-content {
    grid-template-columns: 1fr auto;
    padding: 0 1.25rem;
  }

  /* <nav> has no in-flow content on a phone (the sheet is absolutely positioned), so it is an
     empty zero-height box. It shares the logo's grid cell instead of claiming a column. */
  .logo-section,
  nav {
    grid-area: 1 / 1;
  }

  .nav-actions {
    grid-area: 1 / 2;
  }

  .logo-section svg {
    height: 60px;
  }

  .nav-has-dropdown,
  .nav-cta {
    display: none;
  }

  .nav-toggle {
    display: flex;
  }

  /* Glass, not solid: it floats over the page rather than hiding it, with .nav-scrim blurring
     and dimming what is still visible behind it. Rounded bottom corners and a shadow read as a
     floating sheet. Open and close is a vertical unroll, not a display:none flash: scaleY from
     a fixed top origin plus an opacity fade. display:none cannot be animated, so the sheet
     stays display:flex always and visibility carries the "actually hidden" state, flipping to
     hidden only once the collapse transform finishes (the transition-delay below), so the sheet
     stays visible through its own closing animation.
     The background is near-opaque (the same --surface-nav-rgb the header uses): real-device
     testing showed backdrop-filter does not reliably render here, so the menu has to read
     correctly whether or not the blur applies. */
  .nav-items {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(var(--surface-nav-rgb), 0.94);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    padding: 0.4rem 0 0.6rem;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
    border-radius: 0 0 16px 16px;
    box-shadow: 0 24px 64px rgba(var(--shadow-rgb), 0.45);
    z-index: 999;
    transform-origin: top center;
    transform: scaleY(0);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.32s var(--ease-swing), opacity 0.24s ease, visibility 0s linear 0.32s;
  }

  .nav-items.active {
    transform: scaleY(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: transform 0.34s var(--ease-swing), opacity 0.28s ease;
  }

  .nav-items li {
    width: 100%;
  }

  .nav-link {
