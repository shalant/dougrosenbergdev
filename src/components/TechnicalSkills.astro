---
import SectionDivider from './SectionDivider.astro';
import TechChip from './TechChip.astro';
import siteProperties from '../data/siteproperties.json';
import { loadGithubStats } from '../lib/githubStats';

const categories = [
  { label: 'Languages', chips: ['C#', 'JavaScript', 'TypeScript', 'SQL', 'HTML / CSS'] },
  { label: 'Frameworks & UI', chips: ['.NET 10', 'Blazor', '.NET MAUI (Blazor Hybrid)', 'Angular', 'React', 'Astro', 'Node.js', 'MudBlazor', 'Bootstrap'] },
  { label: 'Cloud & Infrastructure', chips: ['Azure', 'AWS', 'Docker', 'Linux', 'macOS', 'Github Actions', 'Digital Ocean', 'SQL Server', 'Cloudflare'] },
  { label: 'Tooling & Design', chips: ['Figma', 'Squarespace', 'GitLab', 'Entity Framework', 'Syncfusion', 'DevExpress'] },
  { label: 'Marketing & Analytics', chips: ['Google Analytics', 'Meta Pixel', 'Meta Conversions API'] },
  { label: 'AI Tools', chips: ['Claude', 'Gemini', 'Copilot'] },
];

// Fetched at build time (see src/lib/githubStats.ts): a GitHub rate limit or
// network hiccup during build leaves that piece null and the block just omits it
// instead of failing the deploy. Real numbers over invented ones.
const githubStats = await loadGithubStats(siteProperties.gitHub);
const contrib = githubStats?.contributions ?? null;

const utc = (iso: string) => new Date(`${iso}T00:00:00Z`);
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const dayFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Month label above the first week column that starts a new month.
const monthLabels = contrib
  ? contrib.weeks.map((week, i) => {
      const first = week.find(Boolean);
      const prev = i > 0 ? contrib.weeks[i - 1].find(Boolean) : null;
      // No label in the last 3 columns: a 3-letter month would spill past the grid edge.
      if (!first || !prev || i >= contrib.weeks.length - 3) return '';
      return utc(first.date).getUTCMonth() !== utc(prev.date).getUTCMonth() ? monthFmt.format(utc(first.date)) : '';
    })
  : [];

const statTiles = (githubStats
  ? [
      githubStats.commits != null && { value: `${githubStats.commits.toLocaleString()}+`, label: 'commits' },
      githubStats.repos != null && { value: String(githubStats.repos), label: 'repositories' },
      githubStats.yearsActive != null && { value: String(githubStats.yearsActive), label: 'years active' },
      contrib && { value: contrib.total.toLocaleString(), label: 'contributions, past year' },
      contrib && { value: `${contrib.currentStreak}d`, label: 'current streak' },
      contrib && { value: `${contrib.longestStreak}d`, label: 'longest streak, past year' },
    ]
  : []
).filter(Boolean) as { value: string; label: string }[];
---

<section class="skills-section reveal-on-scroll" id="technicalskills">
  <div class="skills-container">

    <div class="skills-header">
      <span class="section-eyebrow">// technical skills</span>
      <h2 class="skills-heading">What I Build With</h2>
      <SectionDivider />
    </div>

    <div class="skills-grid">
      {categories.map((cat) => (
        <div class="skills-category">
          <span class="skills-category__label">{cat.label}</span>
          <div class="skills-category__chips reveal-on-scroll">
            {cat.chips.map((chip) => <TechChip name={chip} />)}
          </div>
        </div>
      ))}
    </div>

    {githubStats && (
      <div class="skills-stats">
        <span class="skills-stats__label">// on github</span>
        <div class="skills-stats__row">
          {statTiles.map((tile) => (
            <div class="skills-stat">
              <span class="skills-stat__value">{tile.value}</span>
              <span class="skills-stat__label">{tile.label}</span>
            </div>
          ))}
        </div>

        <div class="gh-panels">
          {contrib && (
            <div class="gh-panel gh-calendar">
              <div class="gh-calendar__scroll">
                <div
                  class="gh-calendar__grid"
                  role="img"
                  aria-label={`${contrib.total} contributions on GitHub between ${dayFmt.format(utc(contrib.from))} and ${dayFmt.format(utc(contrib.to))}`}
                  style={`--weeks: ${contrib.weeks.length}`}
                >
                  {monthLabels.map((label, i) => (
                    <span class="gh-calendar__month" style={`grid-column: ${i + 1}`}>{label}</span>
                  ))}
                  {contrib.weeks.map((week, col) =>
                    week.map((day, row) =>
                      day ? (
                        <span
                          class={`gh-day gh-day--${day.level}`}
                          style={`grid-column: ${col + 1}; grid-row: ${row + 2}`}
                          title={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${dayFmt.format(utc(day.date))}`}
                        />
                      ) : null,
                    ),
                  )}
                </div>
              </div>
              <div class="gh-calendar__legend" aria-hidden="true">
                <span>less</span>
                {[0, 1, 2, 3, 4].map((l) => <span class={`gh-day gh-day--${l}`} />)}
                <span>more</span>
              </div>
            </div>
          )}

          {githubStats.languages && (
            <div class="gh-panel gh-languages">
              <span class="gh-languages__title">Top languages</span>
              <ul class="gh-languages__list">
                {githubStats.languages.map((lang) => (
                  <li class="gh-lang">
                    <span class="gh-lang__name">{lang.name}</span>
                    <span class="gh-lang__bar"><span class="gh-lang__fill" style={`width: ${lang.percent}%`} /></span>
                    <span class="gh-lang__pct">{lang.percent}%</span>
                  </li>
                ))}
              </ul>
              <span class="gh-languages__note">share of my repos by primary language</span>
            </div>
          )}
        </div>
      </div>
    )}

  </div>
</section>
