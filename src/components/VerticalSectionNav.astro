---
// Homepage-only. Hidden during the hero section (see .vertical-section-nav.past-hero
// in global.css, toggled by nav.js's highlightActive()) - the hero portrait already
// occupies the right side of the viewport at common desktop widths, so the rail only
// reveals once that's no longer competing.
const items = [
  { id: "about", label: "about", path: "M2 13 L2 7.5 A5 5 0 0 0 12 7.5 L12 13" },
  { id: "experience", label: "experience", timeline: true },
  { id: "technicalskills", label: "skills", grid: true },
  { id: "casual", label: "casual", path: "M7 4v3l2 1.5", circle: true },
  { id: "music", label: "music", path: "M5 10.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm6-1.5V3l-6 1.2v6.3" },
  { id: "contact", label: "contact", path: "M1.5 2.5 H12.5 V9 H5.5 L3 11.5 V9 H1.5 Z" },
];
---

<nav class="vertical-section-nav" id="verticalSectionNav" aria-label="Section navigation">
  {items.map((item) => (
    <a href={`#${item.id}`} class="vsn-item" data-section={item.id}>
      <span class="vsn-icon">
        {item.grid ? (
          <svg viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="1.5" y="1.5" width="4.5" height="4.5" rx="0.5" /><rect x="8" y="1.5" width="4.5" height="4.5" rx="0.5" /><rect x="1.5" y="8" width="4.5" height="4.5" rx="0.5" /><rect x="8" y="8" width="4.5" height="4.5" rx="0.5" /></svg>
        ) : item.timeline ? (
          <svg viewBox="0 0 14 14" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="3" cy="4" r="1.3" stroke="none" /><line x1="6.5" y1="4" x2="12" y2="4" /><circle cx="3" cy="8" r="1.3" stroke="none" /><line x1="6.5" y1="8" x2="10" y2="8" /><circle cx="3" cy="12" r="1.3" stroke="none" /><line x1="6.5" y1="12" x2="11" y2="12" /></svg>
        ) : item.circle ? (
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5.25" /><path d={item.path} /></svg>
        ) : (
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin={item.id === "music" || item.id === "contact" ? "round" : undefined} aria-hidden="true"><path d={item.path} /></svg>
        )}
      </span>
      <span class="vsn-label">{item.label}</span>
    </a>
  ))}
</nav>
