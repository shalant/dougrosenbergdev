---
import SectionDivider from './SectionDivider.astro';
import ContactForm from './ContactForm.astro';
---

<section class="contact-section reveal-on-scroll" id="contact">
  <div class="contact-container">
    <h2 class="contact-heading">Get In Touch</h2>
    <SectionDivider />
    <div class="contact-glass">
      <p class="contact-sub">
        Whether you have a project in mind, need a consultation,
        or just want to connect &mdash; I'd love to hear from you.
      </p>
      <ContactForm />
    </div>
  </div>
</section>
