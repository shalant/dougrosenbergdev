---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TechChip from '../../components/TechChip.astro';
import ProjectMediaFrame from '../../components/ProjectMediaFrame.astro';
import webDesign from '../../data/webdesign.json';

// Hand-curated for the hero ring: which of each project's images best represent
// it (best-first), plus each project's overall quality rank (1 = strongest) for
// ordering which projects get a *second* card once every project has its best
// one in. Ported verbatim from WebDesignPage.razor's RingCuration array - update
// by eye when project images change, same as the Blazor version. BackendTools'
// RingCurationService can still generate a suggested ordering; it's pasted in
// by hand here rather than written automatically, same rule as before.
const RING_CARD_COUNT = 12;
const RING_CURATION: { slug: string; projectRank: number; imageIndexesBestFirst: number[] }[] = [
  { slug: 'guacamayo-band', projectRank: 1, imageIndexesBestFirst: [0, 3, 2] },
  { slug: 'arborkin', projectRank: 2, imageIndexesBestFirst: [1, 2, 3] },
  { slug: 'dougrosenberg-music-v2', projectRank: 3, imageIndexesBestFirst: [0, 1] },
  { slug: 'hardware-etc', projectRank: 4, imageIndexesBestFirst: [0, 2] },
  { slug: 'sonus-construction', projectRank: 5, imageIndexesBestFirst: [1] },
  { slug: 'dougrosenberg-music', projectRank: 6, imageIndexesBestFirst: [3] },
  { slug: 'haxbyte', projectRank: 7, imageIndexesBestFirst: [0] },
  { slug: 'gigsync', projectRank: 8, imageIndexesBestFirst: [0] },
];

// Breadth-first, round-robin: round 0 takes every curated project's best image
// (in project-quality order), round 1 takes the second-best from whichever
// projects have one, and so on - the ring always has full breadth before it
// goes deeper into any single project.
function selectRingImages(count: number): string[] {
  const bySlug = new Map(webDesign.projects.map((p) => [p.slug, p]));
  const pools = RING_CURATION
    .filter((c) => bySlug.has(c.slug))
    .sort((a, b) => a.projectRank - b.projectRank)
    .map((c) => c.imageIndexesBestFirst.map((i) => bySlug.get(c.slug)!.images[i]));

  const picks: string[] = [];
  for (let round = 0; picks.length < count; round++) {
    let addedAny = false;
    for (const pool of pools) {
      if (picks.length >= count) break;
      if (round < pool.length) {
        picks.push(pool[round]);
        addedAny = true;
      }
    }
    if (!addedAny) break;
  }
  return picks;
}

const ringImages = selectRingImages(RING_CARD_COUNT);
---

<BaseLayout
  title="Web Design & Case Studies — Douglas Rosenberg"
  description={webDesign.subheadline}
>
  <Header />

  <section class="wd2-hero">
    <div class="wd2-hero__ring" id="wd2HeroRing"></div>
    <div class="wd2-hero__scrim"></div>
    <div class="wd2-hero__glass">
      <span class="section-eyebrow">// web design</span>
      <h1 class="wd2-hero__title">{webDesign.headline}</h1>
      <p class="wd2-hero__sub">{webDesign.subheadline}</p>
      <button type="button" class="hero-btn hero-btn--primary wd2-hero__cta" id="openContactDialog" data-contact-trigger>
        get in touch
      </button>
    </div>
  </section>

  <!-- The contact dialog itself lives in Header.astro (ContactDialog.astro),
       mounted once globally so every page shares one form/instance instead
       of each page carrying its own copy - see public/js/contactDialog.js
       for the open/close wiring this button's data-contact-trigger hooks
       into. This page used to own a bespoke two-path (quick note / project
       inquiry) mailto dialog here; collapsed into the shared form. -->

  <section class="webdesign-projects">
    <div class="webdesign-projects__container">
      <span class="section-eyebrow">// selected work</span>
      <h2 class="webdesign-projects__heading">Live Sites</h2>

      <div class="wd-projects-grid" id="wdProjectsGrid">

        {webDesign.projects.map((project) => (
          <a href={`/webdesign/${project.slug}`} class="wd-project">
            <ProjectMediaFrame alt={`${project.name} website`} images={project.images} />
            <div class="wd-project__meta">
              <span class="wd-project__num">{project.number}</span>
              <span class="about-skill-chip">{project.platform}</span>
              {project.status && <span class="wd-project__wip">{project.status}</span>}
            </div>
            <h3 class="wd-project__name">{project.name}</h3>
            <p class="wd-project__industry">{project.industry}</p>
            <ul class="wd-project__bullets">
              {project.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <span class="wd-project__cta">view case study</span>
          </a>
        ))}

        <article class="wd-project wd-project--static">
          <div class="wd-project__meta">
            <span class="wd-project__num">09</span>
            <span class="about-skill-chip">Blazor Server</span>
            <span class="wd-project__wip">in progress</span>
          </div>
          <h3 class="wd-project__name">coming soon: BizMachina</h3>
          <p class="wd-project__industry">Demo business ERP system</p>
          <ul class="wd-project__bullets">
            <li>Custom Blazor Server, DB, cheap deployment, AI document consumption</li>
          </ul>
        </article>

      </div>
    </div>
  </section>

  <section class="wd2-tools">
    <div class="wd2-tools__container">
      <span class="section-eyebrow">// toolkit</span>
      <div class="wd2-tools__chips">
        {webDesign.tools.map((tool) => <TechChip name={tool} />)}
      </div>
    </div>
  </section>

  <Footer />

  <script is:inline src="/js/ring.js"></script>
  <script type="application/json" id="ringImagesData" set:html={JSON.stringify(ringImages)} />
  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('ringImagesData').textContent);
      DrRing.init('wd2HeroRing', data);
    })();
  </script>
</BaseLayout>

<script>
  // Contact dialog open/close is handled globally by DrContactDialog (see
  // public/js/contactDialog.js) via this page's #openContactDialog button
  // carrying data-contact-trigger - nothing page-specific needed here now
  // that the dialog itself lives in Header.astro instead of on this page.

  // Hover-intent crossfade activation for every ProjectMediaFrame on this page,
  // delegated once instead of N per-card listeners. Only starts the crossfade
  // after the pointer rests on a card for a beat (200ms), so skimming across
  // several cards doesn't set all of them animating at once.
  let hoverTimer: ReturnType<typeof setTimeout> | null = null;
  const grid = document.getElementById('wdProjectsGrid');

  grid?.addEventListener('mouseover', (e) => {
    const frame = (e.target as HTMLElement).closest<HTMLElement>('[data-media-frame]');
    if (!frame || frame.contains(e.relatedTarget as Node)) return;
    if (hoverTimer) clearTimeout(hoverTimer);
    hoverTimer = setTimeout(() => {
      frame.querySelector('.wd-project__frame-stage')?.classList.add('is-active');
    }, 200);
  });

  grid?.addEventListener('mouseout', (e) => {
    const frame = (e.target as HTMLElement).closest<HTMLElement>('[data-media-frame]');
    if (!frame || frame.contains(e.relatedTarget as Node)) return;
    if (hoverTimer) clearTimeout(hoverTimer);
    frame.querySelector('.wd-project__frame-stage')?.classList.remove('is-active');
  });
</script>
