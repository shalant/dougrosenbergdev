---
import SectionDivider from './SectionDivider.astro';
import music from '../data/music.json';
---

<section class="music-section reveal-on-scroll" id="music">
  <div class="music-container">
    <a href="https://www.dougrosenberg.com" target="_blank" rel="noopener noreferrer" class="music-photo__link" aria-label="Doug Rosenberg's music site">
      <img src="/images/dougRosenbergBetterThanTv.jpg"
           alt="Cover of Better Than TV, Doug Rosenberg's album as leader and composer"
           class="music-photo__img"
           loading="lazy" />
    </a>

    <div class="music-text">
      <h2 class="music-heading">From Saxophone to Software</h2>
      <SectionDivider />
      <p class="music-paragraph">{music.paragraph1}</p>
      {music.pressQuote && (
        <figure class="music-press">
          <blockquote class="music-press__quote">&ldquo;{music.pressQuote}&rdquo;</blockquote>
          {music.pressAttribution && <figcaption class="music-press__attribution">{music.pressAttribution}</figcaption>}
        </figure>
      )}
      <a href="https://www.dougrosenberg.com" target="_blank" rel="noopener noreferrer" class="music-more">More at dougrosenberg.com</a>
    </div>
  </div>
</section>
