    margin-top: 0.5rem;
    padding: 0.75rem 1.25rem 1.1rem;
    border-top: 1px solid rgba(var(--accent-rgb), 0.15);
  }

  /* The sheet's own filled button, so it never reads as a second, competing "get in touch"
     (before the scrim existed, the homepage hero's own button showed through underneath). */
  .nav-link--cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.8rem 1rem;
    background: var(--accent-fill);
    border: 2px solid var(--accent-fill);
    border-radius: 2px;
    color: var(--on-accent);
