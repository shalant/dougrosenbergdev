---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Client &amp; Admin Portal — Douglas Rosenberg" description="The client and admin portal is under construction." themeScoped={false}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <div class="dr-theme-scope">
    <section class="login-section">
      <div class="login-container">
        <div class="login-content">
          <h1>Client &amp; Admin Portal</h1>
          <p class="login-subtitle">This is under construction — check back soon.</p>

          <div class="login-suggestions">
            <p>In the meantime:</p>
            <nav class="login-nav">
              <ul>
                <li><a href="/">&larr; Back to Home</a></li>
                <li><a href="/#contact">Contact</a></li>
              </ul>
            </nav>
          </div>
        </div>

        <div class="login-art">
          <svg viewBox="0 0 200 200" class="login-hexagon">
            <defs>
              <linearGradient id="loginHexGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#1abc9c;stop-opacity:0.3" />
                <stop offset="100%" style="stop-color:#2c3e50;stop-opacity:0.3" />
              </linearGradient>
            </defs>
            <polygon points="100,10 190,50 190,150 100,190 10,150 10,50" fill="url(#loginHexGradient)" stroke="#1abc9c" stroke-width="2" opacity="0.6"/>
            <rect x="70" y="95" width="60" height="50" rx="8" fill="none" stroke="#1abc9c" stroke-width="4" opacity="0.5"/>
            <path d="M82 95 V72 a18 18 0 0 1 36 0 V95" fill="none" stroke="#1abc9c" stroke-width="4" opacity="0.5"/>
          </svg>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .login-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  .login-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(var(--accent-rgb), 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .login-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1000px;
    width: 100%;
    position: relative;
    z-index: 2;
    align-items: center;
  }

  .login-content {
    text-align: left;
  }

  .login-content h1 {
    font-size: 2.5rem;
    color: var(--text);
    margin-bottom: 0.5rem;
    font-weight: 600;
    background: none;
    background-image: none;
    background-clip: border-box;
    -webkit-background-clip: border-box;
    -webkit-text-fill-color: var(--text);
    text-shadow: none;
  }

  .login-subtitle {
    font-size: 1.1rem;
    color: rgba(var(--text-rgb), 0.7);
    margin-bottom: 2rem;
  }

  html[data-theme="light"] .login-subtitle {
    color: rgba(var(--text-rgb), 0.85);
  }

  .login-suggestions {
    background: rgba(var(--surface-rgb), 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    border-radius: 12px;
    padding: 2rem;
    margin-top: 2rem;
  }

  .login-suggestions p {
    color: rgba(var(--text-rgb), 0.8);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  html[data-theme="light"] .login-suggestions p {
    color: rgba(var(--text-rgb), 0.85);
  }

  .login-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .login-nav li {
    margin: 0;
  }

  .login-nav a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .login-nav a:hover {
    color: var(--text);
    text-decoration: underline;
    transform: translateX(4px);
  }

  .login-art {
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
  }

  .login-hexagon {
    width: 300px;
    height: 300px;
    animation: login-float 6s ease-in-out infinite;
  }

  @keyframes login-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (max-width: 768px) {
    .login-container {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .login-content {
      text-align: center;
    }

    .login-art {
      order: -1;
    }

    .login-hexagon {
      width: 180px;
      height: 180px;
    }
  }
</style>
