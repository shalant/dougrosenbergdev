---
import SectionDivider from './SectionDivider.astro';
import TechChip from './TechChip.astro';
import siteProperties from '../data/siteproperties.json';
import { loadGithubStats } from '../lib/githubStats';

// Grouped by where each tool sits in a system, top to bottom, rather than by type
// (2026-11-19, replacing the six type groups and their uniform chip wall). Same 35 tools.
const layers = [
  { label: 'Interface', note: 'What people touch', chips: ['HTML / CSS', 'JavaScript', 'TypeScript', 'Blazor', 'MudBlazor', 'Angular', 'React', 'Astro', 'Bootstrap', '.NET MAUI (Blazor Hybrid)'] },
  { label: 'Application', note: 'Where the logic lives', chips: ['C#', '.NET 10', 'Node.js', 'Entity Framework', 'Syncfusion', 'DevExpress'] },
  { label: 'Data', note: 'Where it is kept', chips: ['SQL', 'SQL Server'] },
  { label: 'Platform', note: 'Where it runs', chips: ['Azure', 'AWS', 'Digital Ocean', 'Cloudflare', 'Docker', 'Linux', 'macOS'] },
  { label: 'Delivery', note: 'How it ships', chips: ['Github Actions', 'GitLab'] },
  { label: 'Measurement', note: 'How it is checked', chips: ['Google Analytics', 'Meta Pixel', 'Meta Conversions API'] },
  { label: 'Design', note: 'How it is shaped', chips: ['Figma', 'Squarespace'] },
  { label: 'Assistants', note: 'What helps along the way', chips: ['Claude', 'Gemini', 'Copilot'] },
];

// Fetched at build time (see src/lib/githubStats.ts): a GitHub rate limit or
// network hiccup during build leaves that piece null and the block just omits it
// instead of failing the deploy. Real numbers over invented ones.
const githubStats = await loadGithubStats(siteProperties.gitHub);
const contrib = githubStats?.contributions ?? null;

// The heatmap shows the last 26 weeks, not the full year the totals cover: the
// year view opened on a quiet stretch that read as inactivity, and half a year
// sits at a readable cell size beside the languages panel.
const weeks = contrib ? contrib.weeks.slice(-26) : [];
const shownDays = weeks.flat().filter((d) => d !== null);
const shownTotal = shownDays.reduce((sum, d) => sum + d.count, 0);

const utc = (iso: string) => new Date(`${iso}T00:00:00Z`);
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const dayFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Month label above the first week column that starts a new month.
const monthLabels = weeks.map((week, i) => {
      const first = week.find(Boolean);
      const prev = i > 0 ? weeks[i - 1].find(Boolean) : null;
      // No label in the last 3 columns: a 3-letter month would spill past the grid edge.
      if (!first || !prev || i >= weeks.length - 3) return '';
      return utc(first.date).getUTCMonth() !== utc(prev.date).getUTCMonth() ? monthFmt.format(utc(first.date)) : '';
    });

const statTiles = (githubStats
  ? [
      githubStats.commits != null && { value: `${githubStats.commits.toLocaleString()}+`, label: 'commits' },
      githubStats.repos != null && { value: String(githubStats.repos), label: 'repositories' },
      contrib && { value: contrib.total.toLocaleString(), label: 'contributions, past year' },
      contrib && { value: `${contrib.longestStreak}d`, label: 'longest streak, past year' },
    ]
  : []
).filter(Boolean) as { value: string; label: string }[];
---

<section class="skills-section reveal-on-scroll" id="technicalskills">
  <div class="skills-container">

    <div class="skills-header section-head--ledger">
      <h2 class="skills-heading">What I Build With</h2>
      <SectionDivider />
    </div>

    <div class="skills-layers">
      {layers.map((layer) => (
        <div class="skills-layer">
          <svg class="skills-layer__node" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M7 1 L12.2 4 V10 L7 13 L1.8 10 V4 Z" /></svg>
          <div class="skills-layer__name">
            <span class="skills-layer__label">{layer.label}</span>
            <span class="skills-layer__note">{layer.note}</span>
          </div>
          <div class="skills-layer__items reveal-on-scroll">
            {layer.chips.map((chip) => <TechChip name={chip} />)}
          </div>
        </div>
      ))}
    </div>

    {githubStats && (
      <div class="skills-stats">
        <span class="skills-stats__label">On GitHub</span>
        <div class="skills-stats__row">
          {statTiles.map((tile) => (
            <div class="skills-stat">
              {/* The visible number counts up once (script below); screen
                  readers get the static copy so they never read a midway value. */}
              <span class="skills-stat__value" aria-hidden="true" data-count={tile.value}>{tile.value}</span>
              <span class="sr-only">{tile.value}</span>
              <span class="skills-stat__label">{tile.label}</span>
            </div>
          ))}
        </div>

        <div class="gh-panels">
          {contrib && (
            <div class="gh-panel gh-calendar">
              <div class="gh-calendar__scroll">
                <div
                  class="gh-calendar__grid"
                  role="img"
                  aria-label={`${shownTotal} contributions on GitHub between ${dayFmt.format(utc(shownDays[0].date))} and ${dayFmt.format(utc(contrib.to))}`}
                  style={`--weeks: ${weeks.length}`}
                >
                  {monthLabels.map((label, i) => (
                    <span class="gh-calendar__month" style={`grid-column: ${i + 1}`}>{label}</span>
                  ))}
                  {weeks.map((week, col) =>
                    week.map((day, row) =>
                      day ? (
                        <span
                          class={`gh-day gh-day--${day.level}`}
                          style={`grid-column: ${col + 1}; grid-row: ${row + 2}`}
                          title={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${dayFmt.format(utc(day.date))}`}
                        />
                      ) : null,
                    ),
                  )}
                </div>
              </div>
              <div class="gh-calendar__legend" aria-hidden="true">
                <span>less</span>
                {[0, 1, 2, 3, 4].map((l) => <span class={`gh-day gh-day--${l}`} />)}
                <span>more</span>
              </div>
            </div>
          )}

          {githubStats.languages && (
            <div class="gh-panel gh-languages">
              <span class="gh-languages__title">Top languages</span>
              <ul class="gh-languages__list">
                {githubStats.languages.map((lang) => (
                  <li class="gh-lang">
                    <span class="gh-lang__name">{lang.name}</span>
                    <span class="gh-lang__bar"><span class="gh-lang__fill" style={`width: ${lang.percent}%`} /></span>
                    <span class="gh-lang__pct">{lang.percent}%</span>
                  </li>
                ))}
              </ul>
              <span class="gh-languages__note">share of my repos by primary language</span>
            </div>
          )}
        </div>
      </div>
    )}

  </div>
</section>

<script>
  // Counts each GitHub stat up from zero the first time the row scrolls into
  // view. The real values are already in the HTML, so without JS, with
  // reduced motion, or before the row is visible, the final numbers show.
  const row = document.querySelector<HTMLElement>('.skills-stats__row');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (row && !reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      observer.disconnect();
      row.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const match = (el.dataset.count ?? '').match(/^([\d,]+)(.*)$/);
        if (!match) return;
        const target = Number(match[1].replace(/,/g, ''));
        const suffix = match[2];
        // Hold the final width so the tiles don't reflow as digits are added.
        el.style.minWidth = `${el.offsetWidth}px`;
        const start = performance.now();
        const duration = 900;
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    observer.observe(row);
  }
</script>
