---
// Homepage-only. Hidden during the hero section (see .vertical-section-nav.past-hero
// in global.css, toggled by nav.js's highlightActive()) - the hero portrait already
// occupies the right side of the viewport at common desktop widths, so the rail only
// reveals once that's no longer competing.
//
// Glyphs (2026-11-19): the same hexagon-built family as the top nav (see Header.astro and
// DESIGN_NOTES.md "Nav glyphs"). Work and experience are the top nav's own cube and nodes, so
// a section reads the same in both places. Each glyph has ".base" strokes and one ".lit" part;
// the lit part takes the accent when the section is current or hovered.
const items = [
  {
    id: "work",
    label: "work",
    svg: `<path class="base" d="M7 1 L12.2 4 V10 L7 13 L1.8 10 V4 Z"/><path class="lit" d="M7 7 L1.8 4 M7 7 L12.2 4 M7 7 V13"/>`,
  },
  {
    id: "about",
    label: "about",
    svg: `<path class="base" d="M1.8 13 V11.4 L7 8.4 L12.2 11.4 V13"/><path class="lit" d="M7 1.2 L9.08 2.4 L9.08 4.8 L7 6 L4.92 4.8 L4.92 2.4 Z"/>`,
  },
  {
    id: "experience",
    label: "experience",
    svg: `<path class="base" d="M8 11.6 H10 M8 7.6 H11 M8 2.9 H12.5"/><path class="lit" style="--i:0" d="M4 10.3 L5.13 10.95 L5.13 12.25 L4 12.9 L2.87 12.25 L2.87 10.95 Z"/><path class="lit" style="--i:1" d="M4 5.9 L5.47 6.75 L5.47 8.45 L4 9.3 L2.53 8.45 L2.53 6.75 Z"/><path class="lit" style="--i:2" d="M4 0.5 L6.08 1.7 L6.08 4.1 L4 5.3 L1.92 4.1 L1.92 1.7 Z"/>`,
  },
  {
    id: "technicalskills",
    label: "skills",
    svg: `<path class="base" d="M4.75 2.45 L7 3.75 L7 6.35 L4.75 7.65 L2.5 6.35 L2.5 3.75 Z M9.25 2.45 L11.5 3.75 L11.5 6.35 L9.25 7.65 L7 6.35 L7 3.75 Z"/><path class="lit" d="M7 6.35 L9.25 7.65 L9.25 10.25 L7 11.55 L4.75 10.25 L4.75 7.65 Z"/>`,
  },
  {
    id: "casual",
    label: "casual",
    svg: `<path class="base" d="M7 1.5 L11.76 4.25 L11.76 9.75 L7 12.5 L2.24 9.75 L2.24 4.25 Z"/><path class="lit" d="M7 7 V3.8 M7 7 L9.5 8.4"/>`,
  },
  {
    id: "music",
    label: "music",
    svg: `<path class="base" d="M6.45 10 V3 L11.2 5.6"/><path class="lit" d="M4.8 8.1 L6.45 9.05 L6.45 10.95 L4.8 11.9 L3.15 10.95 L3.15 9.05 Z"/>`,
  },
  {
    id: "contact",
    label: "contact",
    svg: `<path class="base" d="M7 0.8 L11.5 3.4 V8.6 L7 11.2 L3.4 13.2 L3.9 9.8 L2.5 8.6 V3.4 Z"/><circle class="lit fill" cx="7" cy="6" r="1"/>`,
  },
];
---

<nav class="vertical-section-nav" id="verticalSectionNav" aria-label="Section navigation">
  {items.map((item, k) => (
    <a href={`#${item.id}`} class="vsn-item" data-section={item.id} style={`--k:${k}`}>
      <span class="vsn-icon">
        <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><Fragment set:html={item.svg} /></svg>
      </span>
      <span class="vsn-label">{item.label}</span>
    </a>
  ))}
</nav>
