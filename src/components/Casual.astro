---
import SectionDivider from './SectionDivider.astro';
import casual from '../data/casual.json';
---

<section class="casual-section reveal-on-scroll" id="casual">
  <div class="casual-container">

    <div class="casual-header">
      <h2 class="casual-heading">When I'm Not Coding</h2>
      <SectionDivider />
      {casual.detailOrQuote && <blockquote class="casual-quote">{casual.detailOrQuote}</blockquote>}
    </div>

    <div class="casual-body">
      <p class="casual-description">{casual.description}</p>

      <ul class="casual-hobbies">
        {casual.hobbies.map((hobby: { name: string; detail?: string }) => (
          <li class="casual-hobby">
            <span class="casual-hobby__name">{hobby.name}</span>
            {hobby.detail && <span class="casual-hobby__detail">{hobby.detail}</span>}
          </li>
        ))}
      </ul>

    </div>

  </div>
</section>
