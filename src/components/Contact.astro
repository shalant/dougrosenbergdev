---
import SectionDivider from './SectionDivider.astro';
import ContactForm from './ContactForm.astro';
---

<section class="contact-section reveal-on-scroll" id="contact">
  <div class="contact-container">
    <div class="contact-pitch">
      <h2 class="contact-heading">Let&rsquo;s talk</h2>
      <SectionDivider />
      <p class="contact-sub">
        Tell me what you need built: a website, a web app, or help with a
        .NET or ERP system. I&rsquo;ll reply by email.
      </p>
    </div>
    <ContactForm />
  </div>
</section>
