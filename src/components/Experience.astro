---
import SectionDivider from './SectionDivider.astro';
import TechChip from './TechChip.astro';
import experiences from '../data/experience.json';
---

<section class="experience-section reveal-on-scroll" id="experience">
  <div class="experience-container">

    <div class="experience-header">
      <h2 class="experience-heading">Where I've Worked</h2>
      <SectionDivider />
    </div>

    <div class="experience-layout">

      <div class="experience-list" role="tablist" aria-label="Jobs" id="experienceList">
        <span class="experience-list__indicator" aria-hidden="true"></span>
        {experiences.map((exp: any, idx: number) => (
          <button
            class:list={["experience-list__item", { active: idx === 0 }]}
            role="tab"
            id={`exp-tab-${idx}`}
            aria-selected={idx === 0}
            aria-controls={`exp-panel-${idx}`}
            tabindex={idx === 0 ? 0 : -1}
            aria-label={exp.title}
            data-index={idx}
          >
            <span class="experience-list__num">{String(idx + 1).padStart(2, '0')}</span>
            <span class="experience-list__logo-wrap">
              <img src={exp.image} alt={exp.title} class="experience-list__logo" loading="lazy" />
            </span>
            <span class="experience-list__title">{exp.title}</span>
          </button>
        ))}
      </div>

      {experiences.map((exp: any, idx: number) => {
        const detailImage = exp.detailImage ?? exp.image;
        const chips = exp.icons.split(',');
        return (
          <div class="experience-detail" role="tabpanel" id={`exp-panel-${idx}`} aria-labelledby={`exp-tab-${idx}`} data-index={idx} hidden={idx !== 0}>
            <div class:list={["experience-detail__logo-wrap", { "experience-detail__logo-wrap--wide": !!exp.detailImage }]}>
              <img src={detailImage} alt={exp.title} class="experience-detail__logo" loading="lazy" />
            </div>

            <h3 class="experience-detail__title">{exp.title}</h3>
            <p class="experience-detail__meta">
              <span class="experience-detail__company">{exp.company}</span>
            </p>
            <div class="experience-detail__divider"></div>

            <ul class="experience-detail__bullets" id={`exp-bullets-${idx}`}>
              {exp.bulletpoints.map((bullet: string) => <li>{bullet}</li>)}
            </ul>
            <button type="button" class="experience-detail__more" aria-expanded="false" aria-controls={`exp-bullets-${idx}`}>Read more</button>

            <div class="experience-detail__footer">
              <div class="experience-detail__chips">
                {chips.map((chip: string) => <TechChip name={chip.trim()} />)}
              </div>
              {exp.url && exp.url.startsWith('http') && (
                <a href={exp.url} target="_blank" rel="noopener noreferrer" class="experience-detail__link" aria-label={`Visit ${exp.company} website`}>
                  Visit {exp.company}
                </a>
              )}
            </div>
          </div>
        );
      })}

    </div>
  </div>
</section>

<script>
  const list = document.getElementById('experienceList');
  if (list) {
    const tabs = Array.from(list.querySelectorAll<HTMLElement>('.experience-list__item'));
    const indicator = list.querySelector<HTMLElement>('.experience-list__indicator');

    // The desktop list's active marker slides between jobs instead of jumping.
    // Measured rather than computed from the index because item heights vary
    // with title length. CSS hides it on the stacked mobile grid.
    function moveIndicator(tab: HTMLElement) {
      if (!indicator) return;
      indicator.style.transform = `translateY(${tab.offsetTop}px)`;
      indicator.style.height = `${tab.offsetHeight}px`;
    }

    function select(tab: HTMLElement) {
      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-selected', String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });
      document.querySelectorAll<HTMLElement>('.experience-detail').forEach((panel) => {
        panel.hidden = panel.dataset.index !== tab.dataset.index;
      });
      moveIndicator(tab);
    }

    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.experience-list__item');
      if (btn) select(btn);
    });

    // Arrow keys/Home/End per the WAI-ARIA tabs pattern. Only the active tab
    // is in the tab order, so Tab moves straight on to the panel.
    list.addEventListener('keydown', (e) => {
      const current = tabs.indexOf(document.activeElement as HTMLElement);
      if (current === -1) return;
      const targets: Record<string, number> = {
        ArrowDown: current + 1, ArrowRight: current + 1,
        ArrowUp: current - 1, ArrowLeft: current - 1,
        Home: 0, End: tabs.length - 1,
      };
      if (!(e.key in targets)) return;
      e.preventDefault();
      const next = tabs[(targets[e.key] + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });

    const activeTab = () => tabs.find((t) => t.classList.contains('active')) ?? tabs[0];
    moveIndicator(activeTab());
    list.classList.add('has-indicator');
    // Fonts swapping in and viewport changes both shift the items' offsets.
    new ResizeObserver(() => moveIndicator(activeTab())).observe(list);
  }

  // Mobile only (the clamp and the button are both scoped to the 860px
  // breakpoint in CSS): bullets start cut to the first one with an ellipsis
  // so the section isn't several screens tall on a phone. Set from here, not
  // in the markup, so the full text still shows if this script never runs.
  document.querySelectorAll<HTMLButtonElement>('.experience-detail__more').forEach((btn) => {
    const bullets = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    if (!bullets) return;
    bullets.dataset.clamp = 'true';
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(expanded));
      bullets.dataset.clamp = String(!expanded);
      btn.textContent = expanded ? 'Show less' : 'Read more';
    });
  });
</script>
