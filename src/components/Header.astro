    border-color: var(--accent-fill-hover);
    color: var(--on-accent);
  }

  /* Full-screen scrim behind the sheet. The sheet is only as tall as its content, so without
     this the real page underneath showed straight through below it. Blurred and dimmed, with
     the same visibility-delay pattern as .nav-items above. */
  .nav-scrim {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 998;
    background: rgba(var(--scrim-deep-rgb), 0.4);
    backdrop-filter: blur(7px) saturate(1.15);
    -webkit-backdrop-filter: blur(7px) saturate(1.15);
